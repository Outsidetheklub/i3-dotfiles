# Machine-specific values — copy to ~/.config/i3/machine.env and edit.
#
# NOT tracked by the repo (see install.sh / README). Everything here is optional:
# if a variable is unset, the script that uses it falls back to auto-detection or
# stays quiet. That's the point — the repo itself hardcodes nothing.

# Night light. Latitude:longitude, e.g. "59.33:18.07" (Stockholm).
# Unset = redshift is not started at all.
REDSHIFT_LOCATION=""

# Internal/laptop panel, used by projector.sh ($mod+Shift+p / $mod+Shift+x).
# Find yours: xrandr --query | grep ' connected'
INTERNAL_OUTPUT="eDP-1"

# Wi-Fi interface for the rofi network menu ($mod+Shift+n).
# Check with: ip link | grep -o '^[0-9]*: wl[a-z0-9]*'
WLAN_IFACE="wlan0"

# Where screenshots go ($mod+Shift+s etc). Unset = XDG Pictures dir + /Screenshots.
SCREENSHOT_DIR=""

# How long the rofi feedback popups stay up, in seconds (0 = wait for a key).
NOTIFY_TIMEOUT="4"
