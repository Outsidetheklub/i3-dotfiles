# i3status config — Vasileios (2026-09-22)
# Personal copy so we never have to touch /etc/i3status.conf.
# Deliberate changes vs. the system default:
#   • NO IP addresses anywhere (was: W: (86% at Telia-48FE6A) 192.168.1.228)
#   • ipv6 module dropped ("no IPv6" noise)
#   • battery module ADDED for the laptop (this repo is shared with the desktop:
#     format_down = "" keeps it invisible there — i3status has no
#     conditional modules, and the default format_down is the literal
#     text "No battery", which we do not want on the desktop bar.)
#   • ethernet module dropped (wifi only → it only ever said "E: down")

general {
        colors = false
        interval = 5
}

order += "battery all"
order += "wireless _first_"
order += "disk /"
order += "memory"
order += "tztime local"

# NB: %quality already includes its own % sign — don't add another one.
wireless _first_ {
        format_up = "W: %essid %quality"
        format_down = "W: down"
}

disk "/" {
        format = "%avail"
}

memory {
        format = "%used | %available"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

tztime local {
        format = "%H:%M %a %d %b"
}

# Laptop only. %status = Full/Charging/Discharging; hidden entirely on a machine
# with no battery.
battery all {
        format = "%status %percentage %remaining"
        # No battery present (desktop) -> render an empty block (invisible on
        # the black bar) instead of i3status' default "No battery" text.
        format_down = ""
        status_chr = "Charging"
        status_bat = "Discharging"
        status_full = "Full"
        integer_battery_capacity = true
        low_threshold = 15
}
