#!/bin/sh
# pkg-sources launcher.
#
# The tool lives in its own repo (~/pkg-sources) and is NOT vendored here on
# purpose: it needs its backends/ directory beside it, and a lone copy in
# ~/.local/bin silently reported only flatpak/snap (measured: 4 packages instead
# of 285). Wrong output is worse than an honest error, so this wrapper only
# launches the checkout and says what to do when it is missing.
#
# Lost it in a wipe?  git clone git@github.com:Outsidetheklub/pkg-sources.git ~/pkg-sources
set -u

target="$HOME/pkg-sources/pkg-sources"
if [ -x "$target" ]; then
    exec "$target" "$@"
fi

echo "pkg-sources: no checkout at $HOME/pkg-sources" >&2
echo "  clone it:  git clone git@github.com:Outsidetheklub/pkg-sources.git ~/pkg-sources" >&2
exit 1
