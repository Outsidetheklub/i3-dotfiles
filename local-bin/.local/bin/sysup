#!/bin/sh
# sysup — update the whole machine in the right order, then check it.
#
# Why: an "update" is three things that have to agree afterwards —
#
#   1. the Debian packages (kernel + NVIDIA userspace libraries)
#   2. the NVIDIA kernel module (DKMS rebuilds it, but silently)
#   3. flatpak's driver-matched GL runtime, org.freedesktop.Platform.GL.nvidia-<ver>
#
# Point 3 never shows up in apt. When the driver moves from 615 to 620, flatpak
# stays on 615, the NVIDIA ICD disappears from the sandbox, and every flatpak app
# falls back to mesa — which on this machine means the iGPU. Everything starts;
# it just runs like garbage. This script keeps the three in step.
#
#   sysup           update everything, then verify
#   sysup --check   verify only (touches nothing)
#
# Runs as you; asks for the sudo password once. No daemons, no timers, nothing
# running when you are not looking.
set -u

check=0
arg=""
[ $# -gt 0 ] && arg=$1
case "$arg" in
    --check|-c) check=1 ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    "") ;;
    *) printf 'unknown argument: %s\n' "$arg" >&2; exit 2 ;;
esac

hdr()  { printf '\n== %s ==\n' "$1"; }
ok()   { printf '  [ok]  %s\n' "$1"; }
warn() { printf '  [!]   %s\n' "$1"; }
note() { printf '  [-]   %s\n' "$1"; }
have() { command -v "$1" >/dev/null 2>&1; }

# 620.70.06 out of dpkg (epoch and debian revision stripped)
nvidia_pkg_ver() {
    dpkg-query -W nvidia-driver 2>/dev/null |
        awk '{print $2}' |
        sed 's/^[0-9]*://; s/-[^-]*$//'
}
flatpak_branch() { printf '%s' "$1" | tr '.' '-'; }
module_ver()     { cat /sys/module/nvidia/version 2>/dev/null || true; }
smi_ver()        { nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1; }
xorg_ver()       { sed -n 's/.*dlloader X Driver  *\([0-9][0-9.]*\).*/\1/p' /var/log/Xorg.0.log 2>/dev/null | tail -1; }
flatpak_exts()   { flatpak list --runtime --columns=application 2>/dev/null; }
newest_kernel()  { ls -1 /boot/vmlinuz-* 2>/dev/null | sed 's#.*/vmlinuz-##' | sort -V | tail -1; }
# is the NVIDIA module actually built for this kernel? (the 2026-11-06 TTY failure)
module_built_for() { ls /lib/modules/"$1"/updates/dkms/nvidia.ko* >/dev/null 2>&1; }

do_update() {
    hdr "apt"
    note "updating package lists"
    if ! sudo apt-get update; then
        warn "apt update failed — aborting"
        return 1
    fi
    note "full-upgrade (keeps local conffiles on conflict)"
    if ! sudo env DEBIAN_FRONTEND=noninteractive apt-get -y \
            -o Dpkg::Options::=--force-confdef \
            -o Dpkg::Options::=--force-confold \
            full-upgrade; then
        warn "apt full-upgrade failed — aborting before flatpak"
        return 1
    fi

    # same trap, caught before you reboot: fix the module here instead
    nk=$(newest_kernel)
    pk=$(nvidia_pkg_ver)
    if [ -n "$pk" ] && [ -n "$nk" ] && ! module_built_for "$nk"; then
        warn "nvidia module is missing for $nk after the upgrade — fixing it now"
        sudo apt-get install -y linux-headers-"$nk" || warn "could not install headers for $nk"
        sudo dkms autoinstall || warn "dkms autoinstall failed"
        if module_built_for "$nk"; then
            ok "module built for $nk"
        else
            warn "module STILL missing for $nk — do not reboot; fix DKMS first"
        fi
    fi

    if ! have flatpak; then
        note "flatpak is not installed — skipping"
        return 0
    fi

    hdr "flatpak"
    flatpak update -y || warn "flatpak update reported an error"

    pkg=$(nvidia_pkg_ver)
    if [ -z "$pkg" ]; then
        note "no NVIDIA driver — nothing to match"
        return 0
    fi

    br=$(flatpak_branch "$pkg")
    exts=$(flatpak_exts)
    missing=""
    for ref in org.freedesktop.Platform.GL.nvidia-$br org.freedesktop.Platform.GL32.nvidia-$br; do
        printf '%s\n' "$exts" | grep -qx "$ref" || missing="$missing $ref"
    done

    if [ -n "$missing" ]; then
        note "driver $pkg — installing the matching GL runtime"
        # shellcheck disable=SC2086
        if sudo flatpak install -y --noninteractive flathub $missing; then
            ok "GL runtime for $br installed"
        else
            warn "could not install the GL runtime for $br — flatpak apps stay on mesa"
        fi
    else
        ok "GL runtime for $br already present"
    fi

    # stale NVIDIA runtimes (GL/GL32 only) — about 1.6 GB each
    stale=$(flatpak_exts | grep -E '^org\.freedesktop\.Platform\.GL(32)?\.nvidia-' | grep -v -- "-$br\$" || true)
    for ref in $stale; do
        note "removing stale runtime: $ref"
        sudo flatpak uninstall -y "$ref" || warn "could not remove $ref"
    done
    return 0
}

verify() {
    need_reboot=0
    need_logout=0
    problems=0

    hdr "kernel"
    running=$(uname -r)
    newest=$(newest_kernel)
    note "running:           $running"
    [ -n "$newest" ] && note "newest installed:  $newest"
    if [ -n "$newest" ] && [ "$running" != "$newest" ]; then
        warn "a newer kernel is installed — reboot to use it"
        need_reboot=1
    elif [ -n "$newest" ]; then
        ok "running the newest kernel"
    fi

    pkg=$(nvidia_pkg_ver)

    # kernel bump and driver bump can land in the same apt transaction; if DKMS
    # did not build a module for the new kernel, the next reboot is a TTY
    if [ -n "$pkg" ] && [ -n "$newest" ]; then
        if module_built_for "$newest"; then
            ok "nvidia module built for the newest kernel"
        else
            warn "nvidia module is NOT built for $newest — run 'sudo apt install linux-headers-$newest && sudo dkms autoinstall', do not reboot yet"
            problems=1
        fi
    fi

    hdr "NVIDIA"
    if ! have nvidia-smi && [ -z "$pkg" ]; then
        note "no NVIDIA driver here — skipping"
    elif [ -z "$pkg" ]; then
        note "nvidia-smi exists but nvidia-driver is missing from dpkg — check by hand"
        problems=1
    else
        mod=$(module_ver)
        user=$(smi_ver)
        xv=$(xorg_ver)
        note "package (userspace): $pkg"
        if [ -n "$mod" ]; then
            ok "module loaded: $mod"
        else
            warn "the nvidia kernel module is not loaded"
            problems=1
        fi
        [ -n "$user" ] && note "nvidia-smi says:     $user"
        if [ -n "$mod" ] && [ "$mod" != "$pkg" ]; then
            warn "module ($mod) does not match the packages ($pkg) — run 'sudo dkms autoinstall', then reboot"
            need_reboot=1
        fi
        if [ -n "$xv" ]; then
            if [ "$xv" != "$pkg" ]; then
                warn "X server runs $xv, packages are $pkg — log out and back in"
                need_logout=1
            else
                ok "X server uses the same driver"
            fi
        fi
    fi

    hdr "flatpak + NVIDIA runtime"
    if ! have flatpak; then
        note "flatpak is not installed — skipping"
    elif [ -z "$pkg" ]; then
        note "no NVIDIA driver — nothing to match"
    else
        br=$(flatpak_branch "$pkg")
        exts=$(flatpak_exts)
        for ref in org.freedesktop.Platform.GL.nvidia-$br org.freedesktop.Platform.GL32.nvidia-$br; do
            if printf '%s\n' "$exts" | grep -qx "$ref"; then
                ok "$ref"
            else
                warn "$ref is missing — flatpak apps fall back to mesa (iGPU)"
                problems=1
            fi
        done
        stale=$(printf '%s\n' "$exts" | grep -E '^org\.freedesktop\.Platform\.GL(32)?\.nvidia-' | grep -v -- "-$br\$" || true)
        if [ -n "$stale" ]; then
            note "stale runtimes still installed:"
            printf '%s\n' "$stale" | sed 's/^/         /'
        fi
    fi

    hdr "verdict"
    [ "$problems" -ne 0 ] && warn "see [!] above"
    if [ "$need_reboot" -eq 1 ]; then
        printf '  => Reboot (kernel/driver changed).\n'
    elif [ "$need_logout" -eq 1 ]; then
        printf '  => Log out and back in (X still runs the old driver).\n'
    elif [ "$problems" -eq 0 ]; then
        printf '  => All consistent. Nothing left to do.\n'
    else
        printf '  => Fix the points above, then run sysup --check again.\n'
    fi

    [ "$problems" -ne 0 ] && return 1
    [ "$need_reboot" -eq 1 ] && return 1
    return 0
}

if [ "$check" -eq 0 ]; then
    if ! do_update; then
        printf '\n  update aborted — checking the state as it is now.\n'
    fi
fi

verify
exit $?
