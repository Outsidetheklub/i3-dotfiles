// fastfetch — stock module list, monochrome: every colour slot pinned white.
//
// This is fastfetch's own default module list, minus Local IP, with every colour
// set to white. The Arch logo is back on purpose (2026-09-30) — "how else is
// EVERYONE supposed to know that I use arch btw?" — and `type: auto` picks the
// Arch logo here, since fastfetch reports "Arch Linux". So it no longer reads like
// bare command output, and that's the point.
//
// Keys and values are the same white: the 2026-09-29 version dimmed keys to
// #9a9a9a through per-module $1/$2/$3 constants, and those are gone. The fixed
// 12-char key column does the aligning instead.
//
// Why: this box is meant to look like a stock i3 install that happens to be
// monochrome (the terminal/Thunar theme). Colour lives in one attribute per
// surface, if at all — see gtk/.config/gtk-3.0/thunar.css and the i3 bar.
//
// Notes:
//   * Modules that report nothing (DE, WM Theme, Battery on a desktop) drop out
//     on their own — that's why the list is longer than the output.
//   * "Local IP" was deliberately removed. Nothing here needs to know your
//     address, and fastfetch would otherwise print it every time you open a
//     terminal.
//   * Also cut on his request (2026-09-29): Host (the board name), Display (both
//     monitors) and Locale, and the hostname dropped from the title line (it's just
//     the username now). What's left is hardware/software facts only.
//   * `brightColor: true` with every colour explicitly set to white — fastfetch
//     would otherwise tint keys and title on its own.
//   * `percent.type: 1` is what keeps the percentages colourless: it draws a plain
//     number (9 = coloured number, 10 = monochrome bar, 3 = bar + number). Pinning
//     the green/yellow/red usage colours is the fragile way of doing the same job.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "auto",
        "color": {
            "1": "white",
            "2": "white",
            "3": "white",
            "4": "white",
            "5": "white",
            "6": "white",
            "7": "white",
            "8": "white",
            "9": "white"
        },
        "padding": {
            "right": 4
        }
    },

	"display": {
	    "separator": "  ",
	
	    "color": {
	        "keys": "white",
	        "title": "white",
	        "output": "white",
	        "separator": "white"
	    },

	    "brightColor": true,

	    "key": {
	        "width": 12,
	        "type": "string"
	    },

	    "percent": {
	        "type": 1
	    }
	},

    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "terminal",
        {
    "type": "wm",
    "key": "WM"
},
        "break",
        "cpu",
        "gpu",
        "memory"
    ]
}
